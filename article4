    <script>
        const langBtn = document.getElementById('langBtn');
        const bodyDom = document.body;
        if(localStorage.getItem('siteLang') === 'zh'){
            bodyDom.setAttribute('lang','zh-CN');
            langBtn.innerText = 'English';
        }
        langBtn.addEventListener('click',()=>{
            if(bodyDom.lang === 'en'){
                bodyDom.setAttribute('lang','zh-CN');
                langBtn.innerText = 'English';
                localStorage.setItem('siteLang','zh');
            }else{
                bodyDom.setAttribute('lang','en');
                langBtn.innerText = '中文';
                localStorage.setItem('siteLang','en');
            }
        })

        const toggleBtn = document.getElementById('themeBtn');
        if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
            toggleBtn.innerText = '☀️ Light Mode';
        }
        toggleBtn.addEventListener('click', () => {
            document.documentElement.getAttribute('data-theme') === 'dark'
                ? (document.documentElement.setAttribute('data-theme','light'), toggleBtn.innerText='🌙 Dark Mode')
                : (document.documentElement.setAttribute('data-theme','dark'), toggleBtn.innerText='☀️ Light Mode');
        })
    </script>
